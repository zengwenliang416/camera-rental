    },
    "i18n": {
      "enabled": true,
      "locales": [
        "zh-CN",
        "en"
      ],
      "default_locale": "zh-CN",
      "locale_switch_in_prototype": false,
      "source": "openspec/changes/add-customer-return-registration/requirements.md#theme--locale-capability-impact"
    }
