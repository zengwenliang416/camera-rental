    "ambiguous-units-preserved-not-guessed",
    "channel-order-to-rental-order-idempotent",
    "billable-and-occupied-ranges-separated",
    "physical-device-level-scheduling",
    "half-open-Asia-Shanghai-occupied-intervals",
    "transactional-conflict-recheck",
    "authorization-and-after-sale-alerts-deduplicated",
    "durable-failure-replay-safe",
    "explicit-channel-product-to-equipment-mapping",
    "pay-amount-is-rent-revenue",
    "refunds-reported-separately",
