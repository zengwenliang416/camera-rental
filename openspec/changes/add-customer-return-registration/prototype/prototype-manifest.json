  "referenced_requirements": [
    "requirements.md",
    "acceptance.md",
    "spec-map.json",
    "component-impact-map.json"
  ],
  "ui_capabilities": {
    "theme": {
      "support": "light-dark",
      "modes": [
        "light",
        "dark"
