{
  "schema": "specnav.prototype.manifest.v1",
  "version": "1",
  "type": "ui-html",
  "entry": "artifact/index.html",
  "mock_strategy": "static masked fixtures only; no API, database, Xianyu, or Kuaidi100 access",
  "touches_real_data": false,
  "may_promote": false,
  "promotion_requirement": "requires green verifier report, explicit user approval, prototype handoff, and development entry gate",
  "selected_variant": "schedule-tracking-command-center-v1",
  "visual_context": {
    "required_for_ui_html": true,
    "inventory": "visual-inventory.json",
    "project_shell_required": true,
    "generic_shell_allowed": false
  },
  "dependencies": [],
  "referenced_foundation_specs": [
    "ui-design",
    "system-architecture",
    "frontend-backend-data-flow",
    "component-architecture"
  ],
  "referenced_requirements": [
    "requirements.md",
    "acceptance.md",
    "acceptance.json",
    "spec-map.json",
    "component-impact-map.json"
  ],
  "ui_capabilities": {
    "theme": {
      "support": "light-dark",
      "modes": [
        "light",
        "dark"
      ],
      "toggle_in_prototype": true,
      "source": "openspec/specs/ui-design/design.md#Theme & Internationalization"
    },
    "i18n": {
      "enabled": true,
      "locales": [
        "zh-CN",
        "en"
      ],
      "default_locale": "zh-CN",
      "locale_switch_in_prototype": true,
      "source": "openspec/specs/ui-design/design.md#Theme & Internationalization"
    }
  }
}
