  "operational_constraints": [
    "read-only-third-party-integration",
    "credentials-injected-only-at-runtime",
    "integration-disabled-by-default",
    "canonical-body-signed-and-sent-once",
    "fixed-six-month-bounded-update-windows",
    "split-before-10000-row-query-cap",
    "durable-cursor-after-persistence",
    "raw-and-normalized-records-retained",
    "external-identifiers-as-strings",
