# Vite mode: env.local  →  file name must be .env.env.local
# Copy:  cp .env.env.local.example .env.env.local

# ===== 应用 =====
VITE_APP_TITLE=相机租赁管理后台

# ===== 开发服务器 =====
VITE_PORT=5173
VITE_OPEN=true
VITE_DEV=true
VITE_BASE_PATH=/

# ===== 后端 API（yudao-server 默认 48080）=====
VITE_BASE_URL=http://127.0.0.1:48080
VITE_API_URL=/admin-api

# ===== 登录默认值（仅本地开发方便）=====
VITE_APP_TENANT_ENABLE=true
VITE_APP_DEFAULT_LOGIN_TENANT=芋道源码
VITE_APP_DEFAULT_LOGIN_USERNAME=admin
VITE_APP_DEFAULT_LOGIN_PASSWORD=admin123
VITE_APP_CAPTCHA_ENABLE=false
VITE_APP_DOCALERT_ENABLE=false

# ===== 构建 =====
VITE_DROP_DEBUGGER=false
VITE_DROP_CONSOLE=false
VITE_SOURCEMAP=true
VITE_OUT_DIR=dist

# ===== 可选 =====
VITE_GOVIEW_URL=http://127.0.0.1:3000
VITE_UPLOAD_TYPE=server

# ===== API 加解密（本地默认关）=====
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_APP_API_ENCRYPT_HEADER=X-Api-Encrypt
VITE_APP_API_ENCRYPT_ALGORITHM=AES
VITE_APP_API_ENCRYPT_REQUEST_KEY=
VITE_APP_API_ENCRYPT_RESPONSE_KEY=
